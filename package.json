{
  "name": "@zyther/ggl-translate",
  "version": "0.1.13",
  "description": "A lightweight React Google Translate language selector with no runtime dependencies.",

  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": {
      "import": "./dist/styles.css",
      "require": "./dist/styles.css"
    }
  },
  
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],

  "scripts": {
    "dev": "next dev",
    "build:lib": "tsup",
    "build:lib:css": "cp app/lib/styles.css dist/styles.css",
    "build:all": "npm run build:lib && npm run build:lib:css",
    "start": "next start",
    "lint": "next lint",
    "prepublishOnly": "npm run build:all"
  },

  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },

  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "next": "16.3.4",
    "tailwindcss": "^4",
    "tsup": "^8",
    "typescript": "^5"
  },

  "keywords": [
    "react",
    "reactjs",
    "google-translate",
    "google-translate-widget",
    "translate",
    "translator",
    "language-selector",
    "language-select",
    "language-switcher",
    "multilingual",
    "localization",
    "i18n",
    "internationalization",
    "translation",
    "website-translation",
    "react-component",
    "react-library",
    "typescript"
  ],

  "author": "zytherdev <zyther.dev@outlook.com>",
  "homepage": "https://github.com/zytherdev/ggl-translate#readme",

  "bugs": {
    "url": "https://github.com/zytherdev/ggl-translate/issues"
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/zytherdev/ggl-translate.git"
  },

  "license": "MIT"
}